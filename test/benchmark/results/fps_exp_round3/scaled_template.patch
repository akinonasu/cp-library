+struct ScaledDerivativeInput {
+	std::span<const std::uint32_t> values;
+	std::uint32_t factor;
+	std::size_t size() const { return values.size(); }
+	ScaledDerivativeInput first(std::size_t n) const { return {values.first(n), factor}; }
+	ScaledDerivativeInput subspan(std::size_t at, std::size_t n) const { return {values.subspan(at, n), factor}; }
+	operator std::span<const std::uint32_t>() const { return values; }
+};
+class ScaledDerivativeIndices {
+public:
+	ScaledDerivativeIndices(std::size_t first, std::uint32_t factor) {
+		value_ = reduce(times(Indices(first).value(), Factor(factor)), kP);
+		step_ = broadcast(blocked_ntt::detail::multiply_mod(std::uint32_t((std::uint64_t(8) << 32) % kP), factor));
+	}
+	Vec value() const { return value_; }
+	void next() { value_ = reduce(add(value_, step_), kP); }
+private:
+	Vec value_, step_;
+};
+inline void derivative(ScaledDerivativeInput in, std::span<std::uint32_t> d) {
+	const auto f = in.values;
+	const std::size_t n = d.size(), full = std::min(n, f.size() > 0 ? f.size() - 1 : 0) / 8 * 8;
+	ScaledDerivativeIndices index(1, in.factor);
+	for (std::size_t i = 0; i < full; i += 8, index.next())
+		store_unaligned(d.data() + i, canonical(montgomery(load_unaligned(f.data() + i + 1), index.value())));
+	for (std::size_t i = full; i < n; ++i)
+		d[i] = i + 1 < f.size() ? blocked_ntt::detail::multiply_mod(blocked_ntt::detail::multiply_mod(std::uint32_t(i + 1), in.factor), f[i + 1]) : 0;
+}
+inline void subtract_from_derivative(ScaledDerivativeInput in, std::size_t first, std::size_t count,
+									std::uint32_t* out, std::size_t size) {
+	const auto f = in.values;
+	const std::size_t inside = f.size() > first + 1 ? std::min(count, f.size() - first - 1) : 0, full = inside / 8 * 8;
+	ScaledDerivativeIndices index(first + 1, in.factor);
+	for (std::size_t c = 0; c < full; c += 8, index.next()) {
+		const Vec d = canonical(montgomery(load_unaligned(f.data() + first + 1 + c), index.value()));
+		store_unaligned(out + c, reduce(_mm256_sub_epi32(add(d, broadcast(kP)), load_unaligned(out + size + c)), kP));
+	}
+	for (std::size_t c = full; c < count; ++c) {
+		const std::uint32_t d = c < inside ? blocked_ntt::detail::multiply_mod(blocked_ntt::detail::multiply_mod(std::uint32_t(first + 1 + c), in.factor), f[first + 1 + c]) : 0;
+		out[c] = (d + kP - out[size + c]) % kP;
+	}
+}
