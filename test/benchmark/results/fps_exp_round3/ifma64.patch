+namespace detail {
+template <class A>
+inline void divide_exp_by_index(std::size_t first, std::span<std::uint32_t> out, const A& a) {
+	if (out.size() >= 2048 && __builtin_cpu_supports("avx512f") && __builtin_cpu_supports("avx512dq") && __builtin_cpu_supports("avx512ifma"))
+		divide_exp_wide(first, out, a);
+	else divide_by_index(first, out, a);
+}
