+namespace detail {
+using ExpWide = __m512i;
+inline ExpWide exp_wide_load(const std::uint32_t* p) { return _mm512_cvtepu32_epi64(_mm256_loadu_si256(reinterpret_cast<const Vec*>(p))); }
+inline void exp_wide_store(std::uint32_t* p, ExpWide x) { _mm256_storeu_si256(reinterpret_cast<Vec*>(p), _mm512_cvtepi64_epi32(x)); }
+inline ExpWide exp_wide_canonical(ExpWide x) { return _mm512_min_epu64(x, _mm512_sub_epi64(x, _mm512_set1_epi64(kP))); }
+inline constexpr std::uint64_t kExpNI52 = [] {
+	std::uint64_t inv = 1;
+	for (int i = 0; i < 6; ++i) inv *= 2 - std::uint64_t(kP) * inv;
+	return -inv & ((std::uint64_t(1) << 52) - 1);
+}();
+inline ExpWide exp_wide_multiply(ExpWide a, ExpWide b) {
+	const ExpWide zero = _mm512_setzero_si512(), p = _mm512_set1_epi64(kP);
+	const ExpWide low = _mm512_madd52lo_epu64(zero, a, b), high = _mm512_madd52hi_epu64(zero, a, b);
+	const ExpWide q = _mm512_madd52lo_epu64(zero, low, _mm512_set1_epi64(kExpNI52));
+	const ExpWide carry = _mm512_mask_add_epi64(high, _mm512_cmpneq_epu64_mask(low, zero), high, _mm512_set1_epi64(1));
+	return _mm512_madd52hi_epu64(carry, q, p);
+}
+template <class A>
+void divide_exp_wide(std::size_t first, std::span<std::uint32_t> out, const A& a) {
+	constexpr std::size_t kLanes = 64;
+	const std::size_t n = out.size();
+	if (n == 0) return;
+	const std::size_t last = kLanes * ((n - 1) / kLanes);
+	const ExpWide one = _mm512_set1_epi64(1), step = _mm512_set1_epi64(kLanes);
+	const ExpWide lanes = _mm512_setr_epi64(0, 1, 2, 3, 4, 5, 6, 7);
+	ExpWide x[kLanes / 8], prefix[kLanes / 8];
+	const auto valid = [n, lanes](std::size_t at) __attribute__((target("avx512f,avx512dq,avx512ifma"))) {
+		return _mm512_cmp_epu64_mask(_mm512_add_epi64(_mm512_set1_epi64(at), lanes), _mm512_set1_epi64(n), _MM_CMPINT_LT);
+	};
+	const auto masked = [&](ExpWide value, std::size_t at) __attribute__((target("avx512f,avx512dq,avx512ifma"))) {
+		return at + 8 <= n ? value : _mm512_mask_blend_epi64(valid(at), one, value);
+	};
+	for (std::size_t v = 0; v < kLanes / 8; ++v) {
+		x[v] = _mm512_add_epi64(_mm512_set1_epi64(first + 8 * v), lanes);
+		prefix[v] = masked(x[v], 8 * v);
+	}
+	for (std::size_t b = kLanes; b < n; b += kLanes)
+		for (std::size_t v = 0; v < kLanes / 8; ++v) {
+			exp_wide_store(out.data() + b - kLanes + 8 * v, prefix[v]);
+			x[v] = _mm512_add_epi64(x[v], step);
+			prefix[v] = exp_wide_multiply(prefix[v], masked(x[v], b + 8 * v));
+		}
+	alignas(64) std::uint32_t total[kLanes], inverse[kLanes];
+	for (std::size_t v = 0; v < kLanes / 8; ++v) exp_wide_store(total + 8 * v, exp_wide_canonical(prefix[v]));
+	std::uint32_t running = 1;
+	for (std::size_t l = 0; l < kLanes; ++l) {
+		inverse[l] = running;
+		running = blocked_ntt::detail::multiply_mod(running, total[l]);
+	}
+	running = blocked_ntt::detail::multiply_mod(scalar_inverse(running), std::uint32_t((std::uint64_t(1) << 52) % kP));
+	for (std::size_t l = kLanes; l-- > 0;) {
+		inverse[l] = blocked_ntt::detail::multiply_mod(inverse[l], running);
+		running = blocked_ntt::detail::multiply_mod(running, total[l]);
+	}
+	ExpWide inv[kLanes / 8];
+	for (std::size_t v = 0; v < kLanes / 8; ++v) inv[v] = exp_wide_load(inverse + 8 * v);
+	const auto put = [&](std::size_t at, ExpWide reciprocal) __attribute__((target("avx512f,avx512dq,avx512ifma"))) {
+		const ExpWide input = _mm512_cvtepu32_epi64(a(at));
+		const Vec q = _mm512_cvtepi64_epi32(exp_wide_canonical(exp_wide_multiply(reciprocal, input)));
+		if (at + 8 <= n) store_unaligned(out.data() + at, q);
+		else {
+			const Vec mask = _mm256_cmpgt_epi32(broadcast(n - at), _mm256_setr_epi32(0, 1, 2, 3, 4, 5, 6, 7));
+			_mm256_maskstore_epi32(reinterpret_cast<int*>(out.data() + at), mask, q);
+		}
+	};
+	for (std::size_t b = last; b > 0; b -= kLanes)
+		for (std::size_t v = 0; v < kLanes / 8; ++v) {
+			const std::size_t at = b + 8 * v;
+			if (at < n) put(at, exp_wide_multiply(exp_wide_load(out.data() + at - kLanes), inv[v]));
+			inv[v] = exp_wide_multiply(inv[v], masked(x[v], at));
+			x[v] = _mm512_sub_epi64(x[v], step);
+		}
+	for (std::size_t v = 0; v < kLanes / 8; ++v) if (8 * v < n) put(8 * v, inv[v]);
+}
+}
