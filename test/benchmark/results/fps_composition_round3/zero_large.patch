+[[gnu::noinline]] inline void forward_zero_columns(std::uint32_t* a, std::size_t h, std::size_t width, const std::uint32_t* roots) {
+	const Factor z(roots[1], roots[9]);
+	const std::size_t stride = 8 * h;
+	for (std::size_t c = 0; c < h; c += 2 * width)
+		for (std::size_t j = 8 * c; j < 8 * (c + width); j += 8) {
+			const Vec f0 = low(load(a + j)), f1 = low(load(a + j + stride));
+			const Vec f2 = low(load(a + j + 2 * stride)), f3 = low(load(a + j + 3 * stride));
+			const Vec ac = low(add(f0, f2)), amc = low(diff(f0, f2));
+			const Vec bd = low(add(f1, f3)), bmd = times(diff(f1, f3), z);
+			store(a + j, add(ac, bd)), store(a + j + stride, diff(ac, bd));
+			store(a + j + 2 * stride, add(amc, bmd)), store(a + j + 3 * stride, diff(amc, bmd));
+		}
+}
+
+[[gnu::noinline]] inline void inverse_zero_columns(std::uint32_t* a, std::size_t h, std::size_t width, const std::uint32_t* roots) {
+	const Factor z(roots[1], roots[9]);
+	const std::size_t stride = 8 * h;
+	for (std::size_t c = 0; c < h; c += 2 * width)
+		for (std::size_t j = 8 * c; j < 8 * (c + width); j += 8) {
+			const Vec f0 = load(a + j), f1 = load(a + j + stride), f2 = load(a + j + 2 * stride), f3 = load(a + j + 3 * stride);
+			const Vec ab = low(add(f0, f1)), cd = low(add(f2, f3));
+			const Vec amb = low(diff(f0, f1)), cmd = times(diff(f2, f3), z);
+			store(a + j, low(add(ab, cd))), store(a + j + stride, low(add(amb, cmd)));
+			store(a + j + 2 * stride, low(diff(ab, cd))), store(a + j + 3 * stride, low(diff(amb, cmd)));
+		}
+}
