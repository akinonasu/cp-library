+#ifndef CP_COMPONENTS_FPS_COMPOSITION_SIMD_HPP
+#define CP_COMPONENTS_FPS_COMPOSITION_SIMD_HPP
+
+#include "fps_blocked.hpp"
+
+#if defined(__linux__) && defined(__x86_64__) && defined(__GNUC__) && !defined(__clang__)
+namespace fps_detail::composition_poly::wide {
+inline bool supported() {
+	return __builtin_cpu_supports("avx512f") && __builtin_cpu_supports("avx512dq") &&
+		__builtin_cpu_supports("avx512bw") && __builtin_cpu_supports("avx512vl");
+}
+}
+#pragma GCC push_options
+_Pragma("GCC target(\"avx512f,avx512dq,avx512bw,avx512vl\")")
+#pragma GCC optimize("O3")
+namespace fps_detail::composition_poly::wide {
+using Vec = __m512i;
+inline constexpr std::uint32_t kP = 998244353, k2P = 2 * kP;
+inline Vec broadcast(std::uint32_t x) { return _mm512_set1_epi32(int(x)); }
+inline Vec reduce(Vec x) { return _mm512_min_epu32(x, _mm512_sub_epi32(x, broadcast(k2P))); }
+inline Vec add(Vec x, Vec y) { return _mm512_add_epi32(x, y); }
+inline Vec diff(Vec x, Vec y) { return _mm512_sub_epi32(add(x, broadcast(k2P)), y); }
+struct Factor {
+	Vec w, q;
+	explicit Factor(const std::uint32_t* x) : w(broadcast(x[0])), q(broadcast(x[8])) {}
+};
+inline Vec times(Vec x, const Factor& f) {
+	const Vec even = _mm512_srli_epi64(_mm512_mul_epu32(x, f.q), 32);
+	const Vec odd = _mm512_mul_epu32(_mm512_srli_epi64(x, 32), f.q);
+	const Vec q = _mm512_mask_blend_epi32(0xAAAA, even, odd);
+	return _mm512_sub_epi32(_mm512_mullo_epi32(x, f.w), _mm512_mullo_epi32(q, broadcast(kP)));
+}
+[[gnu::noinline]] inline void forward_columns(std::uint32_t* a, std::size_t h, std::size_t width,
+		const std::uint32_t* x, const std::uint32_t* y) {
+	const Factor wx(x), wy(y), wz(y + 1);
+	const std::size_t stride = 8 * h;
+	for (std::size_t c = 0; c < h; c += 2 * width)
+		for (std::size_t j = 8 * c; j < 8 * (c + width); j += 16) {
+			const Vec f0 = reduce(_mm512_loadu_si512(a + j));
+			const Vec f1 = reduce(_mm512_loadu_si512(a + j + stride));
+			const Vec f2 = times(_mm512_loadu_si512(a + j + 2 * stride), wx);
+			const Vec f3 = times(_mm512_loadu_si512(a + j + 3 * stride), wx);
+			const Vec ac = reduce(add(f0, f2)), amc = reduce(diff(f0, f2));
+			const Vec bd = times(add(f1, f3), wy), bmd = times(diff(f1, f3), wz);
+			_mm512_storeu_si512(a + j, add(ac, bd));
+			_mm512_storeu_si512(a + j + stride, diff(ac, bd));
+			_mm512_storeu_si512(a + j + 2 * stride, add(amc, bmd));
+			_mm512_storeu_si512(a + j + 3 * stride, diff(amc, bmd));
+		}
+}
+[[gnu::noinline]] inline void inverse_columns(std::uint32_t* a, std::size_t h, std::size_t width,
+		const std::uint32_t* x, const std::uint32_t* y) {
+	const Factor wx(x), wy(y), wz(y + 1);
+	const std::size_t stride = 8 * h;
+	for (std::size_t c = 0; c < h; c += 2 * width)
+		for (std::size_t j = 8 * c; j < 8 * (c + width); j += 16) {
+			const Vec f0 = _mm512_loadu_si512(a + j), f1 = _mm512_loadu_si512(a + j + stride);
+			const Vec f2 = _mm512_loadu_si512(a + j + 2 * stride), f3 = _mm512_loadu_si512(a + j + 3 * stride);
+			const Vec ab = reduce(add(f0, f1)), cd = reduce(add(f2, f3));
+			const Vec amb = times(diff(f0, f1), wy), cmd = times(diff(f2, f3), wz);
+			_mm512_storeu_si512(a + j, reduce(add(ab, cd)));
+			_mm512_storeu_si512(a + j + stride, reduce(add(amb, cmd)));
+			_mm512_storeu_si512(a + j + 2 * stride, times(diff(ab, cd), wx));
+			_mm512_storeu_si512(a + j + 3 * stride, times(diff(amb, cmd), wx));
+		}
+}
+
+}
+#pragma GCC pop_options
+#endif
+#endif
