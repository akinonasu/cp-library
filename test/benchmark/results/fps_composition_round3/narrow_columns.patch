+#ifndef CP_COMPONENTS_FPS_COMPOSITION_SIMD_HPP
+#define CP_COMPONENTS_FPS_COMPOSITION_SIMD_HPP
+
+#include "fps_blocked.hpp"
+
+#if defined(__linux__) && defined(__x86_64__) && defined(__GNUC__) && !defined(__clang__)
+#pragma GCC push_options
+_Pragma("GCC target(\"avx2\")")
+#pragma GCC optimize("O3")
+namespace fps_detail::composition_poly::narrow {
+using Vec = __m256i;
+inline constexpr std::uint32_t kP = 998244353, k2P = 2 * kP;
+inline Vec broadcast(std::uint32_t x) { return _mm256_set1_epi32(int(x)); }
+inline Vec reduce(Vec x) { return _mm256_min_epu32(x, _mm256_sub_epi32(x, broadcast(k2P))); }
+inline Vec add(Vec x, Vec y) { return _mm256_add_epi32(x, y); }
+inline Vec diff(Vec x, Vec y) { return _mm256_sub_epi32(add(x, broadcast(k2P)), y); }
+struct Factor {
+	Vec w, q;
+	explicit Factor(const std::uint32_t* x) : w(broadcast(x[0])), q(broadcast(x[8])) {}
+};
+inline Vec times(Vec x, const Factor& f) {
+	const Vec even = _mm256_srli_epi64(_mm256_mul_epu32(x, f.q), 32);
+	const Vec odd = _mm256_mul_epu32(_mm256_srli_epi64(x, 32), f.q);
+	const Vec q = _mm256_blend_epi32(even, odd, 0xAA);
+	return _mm256_sub_epi32(_mm256_mullo_epi32(x, f.w), _mm256_mullo_epi32(q, broadcast(kP)));
+}
+[[gnu::noinline]] inline void forward_columns(std::uint32_t* a, std::size_t h, std::size_t width,
+		const std::uint32_t* x, const std::uint32_t* y) {
+	const Factor wx(x), wy(y), wz(y + 1);
+	const std::size_t stride = 8 * h;
+	for (std::size_t c = 0; c < h; c += 2 * width)
+		for (std::size_t j = 8 * c; j < 8 * (c + width); j += 8) {
+			const Vec f0 = reduce(_mm256_loadu_si256(reinterpret_cast<const Vec*>(a + j)));
+			const Vec f1 = reduce(_mm256_loadu_si256(reinterpret_cast<const Vec*>(a + j + stride)));
+			const Vec f2 = times(_mm256_loadu_si256(reinterpret_cast<const Vec*>(a + j + 2 * stride)), wx);
+			const Vec f3 = times(_mm256_loadu_si256(reinterpret_cast<const Vec*>(a + j + 3 * stride)), wx);
+			const Vec ac = reduce(add(f0, f2)), amc = reduce(diff(f0, f2));
+			const Vec bd = times(add(f1, f3), wy), bmd = times(diff(f1, f3), wz);
+			_mm256_storeu_si256(reinterpret_cast<Vec*>(a + j), add(ac, bd));
+			_mm256_storeu_si256(reinterpret_cast<Vec*>(a + j + stride), diff(ac, bd));
+			_mm256_storeu_si256(reinterpret_cast<Vec*>(a + j + 2 * stride), add(amc, bmd));
+			_mm256_storeu_si256(reinterpret_cast<Vec*>(a + j + 3 * stride), diff(amc, bmd));
+		}
+}
+[[gnu::noinline]] inline void inverse_columns(std::uint32_t* a, std::size_t h, std::size_t width,
+		const std::uint32_t* x, const std::uint32_t* y) {
+	const Factor wx(x), wy(y), wz(y + 1);
+	const std::size_t stride = 8 * h;
+	for (std::size_t c = 0; c < h; c += 2 * width)
+		for (std::size_t j = 8 * c; j < 8 * (c + width); j += 8) {
+			const Vec f0 = _mm256_loadu_si256(reinterpret_cast<const Vec*>(a + j)), f1 = _mm256_loadu_si256(reinterpret_cast<const Vec*>(a + j + stride));
+			const Vec f2 = _mm256_loadu_si256(reinterpret_cast<const Vec*>(a + j + 2 * stride)), f3 = _mm256_loadu_si256(reinterpret_cast<const Vec*>(a + j + 3 * stride));
+			const Vec ab = reduce(add(f0, f1)), cd = reduce(add(f2, f3));
+			const Vec amb = times(diff(f0, f1), wy), cmd = times(diff(f2, f3), wz);
+			_mm256_storeu_si256(reinterpret_cast<Vec*>(a + j), reduce(add(ab, cd)));
+			_mm256_storeu_si256(reinterpret_cast<Vec*>(a + j + stride), reduce(add(amb, cmd)));
+			_mm256_storeu_si256(reinterpret_cast<Vec*>(a + j + 2 * stride), times(diff(ab, cd), wx));
+			_mm256_storeu_si256(reinterpret_cast<Vec*>(a + j + 3 * stride), times(diff(amb, cmd), wx));
+		}
+}
+
+}
+#pragma GCC pop_options
+#endif
+#endif
