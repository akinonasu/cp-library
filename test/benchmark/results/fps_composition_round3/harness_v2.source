import argparse
from concurrent.futures import ThreadPoolExecutor
import fcntl
import hashlib
import json
import os
from pathlib import Path
import random
import shutil
import statistics
import subprocess
import time

ROOT = Path(__file__).resolve().parents[2]
PROBLEMS = {
    'compose': ('composition_of_formal_power_series', 'fps_compose.test.cpp', 409336),
    'compose_large': ('composition_of_formal_power_series_large', 'fps_compose_large.test.cpp', 409535),
    'inverse': ('compositional_inverse_of_formal_power_series', 'fps_compositional_inverse.test.cpp', 409399),
    'inverse_large': ('compositional_inverse_of_formal_power_series_large', 'fps_compositional_inverse_large.test.cpp', 409549),
}
sha = lambda p: hashlib.sha256(p.read_bytes()).hexdigest()

def main():
    p = argparse.ArgumentParser()
    p.add_argument('--candidate-root', type=Path, default=ROOT)
    p.add_argument('--label', required=True)
    p.add_argument('--operations', nargs='+', default=list(PROBLEMS))
    p.add_argument('--cases', nargs='+', default=['max_random_00', 'max_random_01', 'max_random_02'])
    p.add_argument('--trials', type=int, default=21)
    p.add_argument('--seed', type=int, default=20261029)
    a = p.parse_args()
    work = Path('/tmp/fps-composition-round3-' + a.label)
    work.mkdir(exist_ok=True)
    outpath = ROOT / ('test/benchmark/results/fps_composition_round3/' + a.label + '.json')
    baseline = Path('/tmp/cp-fps-round3-base')
    flags = ['-std=c++23', '-O2', '-DEVAL', '-DONLINE_JUDGE', '-ftrivial-auto-var-init=zero', '-march=haswell']
    previous_path = ROOT / 'test/benchmark/results/fps_round2_all_speed.json'
    previous = json.loads(previous_path.read_text())
    compiler = subprocess.check_output(['g++', '--version'], text=True).splitlines()[0]
    assert compiler == previous['compiler'] and flags == previous['flags']
    for name, digest in previous['sources']['current'].items(): assert sha(baseline / name) == digest, name
    tree = work / 'candidate'
    if tree.exists(): shutil.rmtree(tree)
    shutil.copytree(baseline, tree, ignore=shutil.ignore_patterns('benchmark', 'docs', '.github'))
    for name in ['fps_composition.hpp', 'fps_composition_simd.hpp', 'fps_reversion.hpp']:
        source = a.candidate_root / 'components' / name
        if source.exists(): shutil.copy2(source, tree / 'components' / name)
    result = dict(baseline='bd951dce6fdcb3ea9db4fcef342147012a8ab0c0', compiler=compiler, flags=flags,
                  label=a.label, hardware=subprocess.check_output(['lscpu'], text=True), cpu=2, trials=a.trials, seed=a.seed,
                  metric='whole process perf_counter_ns wall milliseconds; file input/output; warmup 1; checker outside timed region',
                  harness_sha256=sha(Path(__file__)), controls_manifest_sha256=sha(previous_path), sources={}, judge=[])
    for name, path in [('baseline', baseline), ('candidate', tree)]:
        result['sources'][name + '_headers'] = {str(x.relative_to(path)): sha(x) for folder in ('fps', 'components', 'math', 'convolution', 'test') for x in (path / folder).glob('*.hpp')}
    def save(): outpath.write_text(json.dumps(result, indent=2) + '\n')
    binaries = {}
    for op in a.operations:
        problem, _, _ = PROBLEMS[op]
        for variant, old_variant in [('baseline', 'current'), ('reference', 'reference')]:
            entry = previous['sources'][problem + '_' + old_variant]
            binary = Path(entry['command'][-1])
            assert sha(binary) == entry['binary_sha256']
            result['sources'][op + '_' + variant] = entry
            binaries[op + '_' + variant] = binary
    def build(op):
        problem, filename, _ = PROBLEMS[op]
        source, binary = tree / 'test' / filename, work / (op + '_candidate')
        cmd = ['g++', *flags, '-I', str(tree), str(source), '-o', str(binary)]
        with open('/tmp/cp-fps-tuning.lock', 'w') as lock:
            fcntl.flock(lock, fcntl.LOCK_SH)
            r = subprocess.run(cmd, capture_output=True, text=True)
        (work / (op + '.build.log')).write_text(r.stdout + r.stderr)
        r.check_returncode()
        return op, binary, dict(command=cmd, source_sha256=sha(source), binary_sha256=sha(binary))
    with ThreadPoolExecutor(max_workers=2) as pool:
        for op, binary, entry in pool.map(build, a.operations):
            binaries[op + '_candidate'] = binary
            result['sources'][op + '_candidate'] = entry
            save(); print('built', op, flush=True)
    with open('/tmp/cp-fps-tuning.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        os.sched_setaffinity(0, {2})
        rng = random.Random(a.seed)
        for op in a.operations:
            problem, _, _ = PROBLEMS[op]
            folder = Path('/tmp/library-checker-problems/polynomial') / problem
            for case in a.cases:
                inp, answer = folder / ('in/' + case + '.in'), folder / ('out/' + case + '.out')
                row = dict(problem=problem, case=case, input_sha256=sha(inp), answer_sha256=sha(answer), orders=[], variants={})
                samples = {name: [] for name in ('baseline', 'candidate', 'reference')}
                for rep in range(a.trials + 1):
                    order = list(samples); rng.shuffle(order); row['orders'].append(order)
                    for variant in order:
                        output = work / (op + '_' + variant + '.out')
                        with inp.open('rb') as source, output.open('wb') as target:
                            started = time.perf_counter_ns()
                            subprocess.run([str(binaries[op + '_' + variant])], stdin=source, stdout=target, check=True)
                            elapsed = (time.perf_counter_ns() - started) / 1e6
                        check = subprocess.run([str(folder / 'checker'), str(inp), str(output), str(answer)], capture_output=True, text=True)
                        if check.returncode: raise RuntimeError(check.stderr)
                        if rep: samples[variant].append(elapsed)
                for variant, values in samples.items(): row['variants'][variant] = dict(median_ms=statistics.median(values), samples_ms=values, output_sha256=sha(work / (op + '_' + variant + '.out')))
                result['judge'].append(row); save(); print(problem, case, {v:x['median_ms'] for v,x in row['variants'].items()}, flush=True)

if __name__ == '__main__': main()
