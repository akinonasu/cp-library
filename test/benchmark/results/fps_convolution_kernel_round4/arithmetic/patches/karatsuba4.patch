+[[gnu::target("avx512f,avx512vl,avx512dq")]]
+[[gnu::noinline]] inline void bottom_karatsuba4(Vec* a, Vec* b, std::size_t nv, std::size_t first,
+                                             const std::uint32_t* roots, const std::uint32_t* inverse_roots) {
+	using namespace blocked_poly::detail;
+	const Vec p = broadcast(kP), p2 = broadcast(2 * kP);
+	for (std::size_t j = 0, g = first; j < nv; j += 4, ++g) {
+		Vec af[4] = {a[j], a[j + 1], a[j + 2], a[j + 3]};
+		Vec bf[4] = {b[j], b[j + 1], b[j + 2], b[j + 3]};
+		forward_h1(af, Group(roots, g));
+		forward_h1(bf, Group(roots, g));
+		const Factor yw = entry(roots, 2 * g), zw = entry(roots, 2 * g + 1);
+		Vec aw[4];
+#pragma GCC unroll 4
+		for (int t = 0; t < 4; ++t) {
+			af[t] = canonical(af[t]);
+			bf[t] = canonical(bf[t]);
+			const Vec wa = times(af[t], t < 2 ? yw : zw);
+			aw[t] = reduce(t % 2 ? _mm256_sub_epi32(p2, wa) : wa, kP);
+		}
+		for (int t = 0; t < 4; t += 2) {
+			const auto separate = [](Vec x) __attribute__((target("avx512f,avx512vl,avx512dq"))) {
+				return _mm256_permute4x64_epi64(_mm256_shuffle_epi32(x, 0xd8), 0xd8);
+			};
+			const Vec ax = separate(af[t]), ay = separate(af[t + 1]);
+			const Vec bx = separate(bf[t]), by = separate(bf[t + 1]);
+			const Vec wx = separate(aw[t]), wy = separate(aw[t + 1]);
+			alignas(32) Vec av[3], bv[3], wv[3], product[3];
+			av[0] = _mm256_permute2x128_si256(ax, ay, 0x20);
+			av[1] = _mm256_permute2x128_si256(ax, ay, 0x31);
+			bv[0] = _mm256_permute2x128_si256(bx, by, 0x20);
+			bv[1] = _mm256_permute2x128_si256(bx, by, 0x31);
+			wv[0] = _mm256_permute2x128_si256(wx, wy, 0x20);
+			wv[1] = _mm256_permute2x128_si256(wx, wy, 0x31);
+			av[2] = reduce(add(av[0], av[1]), kP);
+			bv[2] = reduce(add(bv[0], bv[1]), kP);
+			wv[2] = reduce(add(wv[0], wv[1]), kP);
+			leaf_three4_regs(av, wv, bv, product);
+			const Vec c0 = canonical(product[0]), c2 = canonical(product[1]), cs = canonical(product[2]);
+			const Factor base = t < 2 ? yw : zw;
+			Factor weight(0);
+			weight.w = _mm256_blend_epi32(base.w, _mm256_sub_epi32(p, base.w), 0xf0);
+			weight.q = _mm256_blend_epi32(base.q, _mm256_xor_si256(base.q, _mm256_set1_epi32(-1)), 0xf0);
+			const Vec wc2 = reduce(times(c2, weight), kP);
+			const Vec yc2 = _mm256_blend_epi32(_mm256_shuffle_epi32(c2, 0x93), _mm256_shuffle_epi32(wc2, 0x93), 0x11);
+			const Vec ce = reduce(add(c0, yc2), kP), co = difference(difference(cs, c0), c2);
+			const Vec lo = _mm256_unpacklo_epi32(ce, co), hi = _mm256_unpackhi_epi32(ce, co);
+			af[t] = _mm256_permute2x128_si256(lo, hi, 0x20);
+			af[t + 1] = _mm256_permute2x128_si256(lo, hi, 0x31);
+		}
+		inverse_h1(af, Group(inverse_roots, g));
+		a[j] = af[0];
+		a[j + 1] = af[1];
+		a[j + 2] = af[2];
+		a[j + 3] = af[3];
+	}
+}
