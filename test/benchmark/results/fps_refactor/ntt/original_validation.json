    "code": "#include \"CompareBefore.hpp\"\n#include \"CompareAfter.hpp\"\n#include <random>\n#include <cstdio>\n#include <cstdlib>\nusing A=fps_detail::NTTBefore;\nusing B=fps_detail::NTTAfter;\nvoid equal(const std::vector<unsigned>&a,const std::vector<unsigned>&b,const char *op,int n,int c){\n for(std::size_t i=0;i<a.size();++i)if(A::out(a[i])!=B::out(b[i])){std::fprintf(stderr,\"%s n%d c%d i%zu a%u b%u\\n\",op,n,c,i,a[i],b[i]);std::abort();}\n}\nint main(){\n std::mt19937 rng(20261021);\n for(int size=2;size<=65536;size*=2){\n  A a(size);B b(size);\n  for(int cols=1;cols<=size;cols*=2){\n   int rows=size/cols;std::vector<unsigned>x(2*size),y;\n   for(auto &v:x)v=rng()%A::twice;y=x;\n   a.project(x.data(),rows,cols);b.project(y.data(),rows,cols);equal(x,y,\"project\",size,cols);\n   for(auto &v:x)v=rng()%A::twice;y=x;\n   a.composition_forward_y(x.data(),size,cols);b.composition_forward_y(y.data(),size,cols);equal(x,y,\"forward_y\",size,cols);\n   if(cols>=2&&cols<=(size/2))for(bool inv:{false,true}){\n    for(auto &v:x)v=rng()%A::twice;y=x;\n    a.double_y(x.data(),rows,cols,inv);b.double_y(y.data(),rows,cols,inv);equal(x,y,\"double_y\",size,cols);\n   }\n  }\n }\n std::puts(\"NTT composition internal paths match through 65536\");\n}\n",
    "operations": [
      "project",
      "composition_forward_y",
      "double_y"
    ],
