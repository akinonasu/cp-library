import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import random
import shutil
import statistics
import subprocess
import time

ROOT = Path(__file__).resolve().parents[2]
PROBLEMS = {
    'compose': ('composition_of_formal_power_series', 'fps_compose.test.cpp', 409336),
    'compose_large': ('composition_of_formal_power_series_large', 'fps_compose_large.test.cpp', 409535),
    'inverse': ('compositional_inverse_of_formal_power_series', 'fps_compositional_inverse.test.cpp', 409399),
    'inverse_large': ('compositional_inverse_of_formal_power_series_large', 'fps_compositional_inverse_large.test.cpp', 409549),
}


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    p = argparse.ArgumentParser()
    p.add_argument('--baseline', type=Path, default=Path('/tmp/cp-fps-round2-base'))
    p.add_argument('--work', type=Path, required=True)
    p.add_argument('--output', type=Path, required=True)
    p.add_argument('--trials', type=int, default=21)
    p.add_argument('--operations', nargs='+', default=['compose', 'compose_large'])
    p.add_argument('--overlay', nargs='+', default=['components/fps_composition.hpp'])
    p.add_argument('--cpu', type=int, default=2)
    a = p.parse_args()
    a.work.mkdir(parents=True, exist_ok=True)
    flags = ['-std=c++23', '-O2', '-DEVAL', '-DONLINE_JUDGE', '-ftrivial-auto-var-init=zero', '-march=haswell']
    result = dict(baseline_commit='144ae32387675fa2a889ea3e8cd19b03ad5016bf', baseline=str(a.baseline),
                  compiler=subprocess.check_output(['g++', '--version'], text=True).splitlines()[0],
                  hardware=subprocess.check_output(['lscpu'], text=True), flags=flags,
                  cpu=a.cpu, trials=a.trials, seed=20261018, harness_sha256=sha(Path(__file__)),
                  clock='perf_counter_ns; process spawn through wait; file output; warmup 1', sources={}, judge=[])
    def save():
        a.output.parent.mkdir(parents=True, exist_ok=True)
        a.output.write_text(json.dumps(result, indent=2) + '\n')
    with open('/tmp/cp-fps-tuning.lock', 'w') as lock:
        tree = a.work / 'candidate'
        if tree.exists(): shutil.rmtree(tree)
        shutil.copytree(a.baseline, tree)
        for name in a.overlay: shutil.copy2(ROOT / name, tree / name)
        builds = {}
        for variant, include in [('baseline', a.baseline), ('candidate', tree)]:
            result['sources'][variant + '_headers'] = {str(x.relative_to(include)): sha(x) for folder in ('fps', 'components', 'math', 'convolution') for x in (include / folder).rglob('*.hpp')}
        for op in a.operations:
            problem, filename, refid = PROBLEMS[op]
            for variant, include in [('baseline', a.baseline), ('candidate', tree), ('reference', tree)]:
                name = op + '_' + variant
                source = (a.baseline / 'test' / filename) if variant != 'reference' else Path('/tmp/fps-reference') / problem / (str(refid) + '.cpp')
                exe = a.work / name
                command = ['g++', *flags, '-I', str(include), '-I', str(include / 'test'), str(source), '-o', str(exe)]
                fcntl.flock(lock, fcntl.LOCK_SH)
                try:
                    built = subprocess.run(command, capture_output=True, text=True)
                    (a.work / (name + '.build.log')).write_text(built.stdout + built.stderr)
                    built.check_returncode()
                finally: fcntl.flock(lock, fcntl.LOCK_UN)
                result['sources'][name] = dict(source_sha256=sha(source), binary_sha256=sha(exe), command=command)
                builds[name] = exe
                save(); print('built', name, flush=True)
        fcntl.flock(lock, fcntl.LOCK_EX)
        os.sched_setaffinity(0, {a.cpu})
        rng = random.Random(result['seed'])
        for op in a.operations:
            problem, _, _ = PROBLEMS[op]
            folder = Path('/tmp/library-checker-problems/polynomial') / problem
            inp, answer = folder / 'in/max_random_00.in', folder / 'out/max_random_00.out'
            row = dict(problem=problem, input_sha256=sha(inp), answer_sha256=sha(answer), variants={})
            samples = {v: [] for v in ('baseline', 'candidate', 'reference')}
            orders = []
            for rep in range(a.trials + 1):
                order = list(samples); rng.shuffle(order); orders.append(order)
                for v in order:
                    output = a.work / (op + '_' + v + '.out')
                    with inp.open('rb') as source, output.open('wb') as out:
                        begin = time.perf_counter_ns()
                        subprocess.run([str(builds[op + '_' + v])], stdin=source, stdout=out, check=True)
                        elapsed = (time.perf_counter_ns() - begin) / 1e6
                    checked = subprocess.run([str(folder / 'checker'), str(inp), str(output), str(answer)], capture_output=True, text=True)
                    if checked.returncode: raise RuntimeError(checked.stderr)
                    if rep: samples[v].append(elapsed)
            for v, values in samples.items(): row['variants'][v] = dict(median_ms=statistics.median(values), samples_ms=values, output_sha256=sha(a.work / (op + '_' + v + '.out')))
            row['orders'] = orders
            result['judge'].append(row); save(); print(problem, {v: x['median_ms'] for v, x in row['variants'].items()}, flush=True)


if __name__ == '__main__': main()
