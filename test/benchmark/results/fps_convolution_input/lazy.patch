+inline void forward_radix8_values(Vec* f, std::size_t q, std::size_t j, Vec f0, Vec f1, Vec f2, Vec f3,
+								 const Factor& i, const Factor& y, const Factor& z) {
+	const Vec g0 = reduce(add(f0, f2), 2 * kP), g1 = reduce(add(f1, f3), 2 * kP);
+	const Vec h0 = reduce(diff(f0, f2), 2 * kP), ih1 = times(diff(f1, f3), i);
+	f[j] = add(g0, g1), f[j + q] = diff(g0, g1);
+	f[j + 2 * q] = add(h0, ih1), f[j + 3 * q] = diff(h0, ih1);
+	const Vec if2 = times(f2, i), if3 = times(f3, i);
+	const Vec u0 = reduce(add(f0, if2), 2 * kP), v0 = reduce(diff(f0, if2), 2 * kP);
+	const Vec yu1 = times(add(f1, if3), y), zv1 = times(diff(f1, if3), z);
+	f[j + 4 * q] = add(u0, yu1), f[j + 5 * q] = diff(u0, yu1);
+	f[j + 6 * q] = add(v0, zv1), f[j + 7 * q] = diff(v0, zv1);
+}
+
+template <int Stream, int Count>
+inline Vec load_radix8_input(const Mint* in, std::size_t offset, std::size_t q) {
+	if constexpr (Stream < Count) {
+		Vec x;
+		std::memcpy(&x, in + offset + 8 * q * Stream, sizeof(x));
+		return x;
+	} else return _mm256_setzero_si256();
+}
+
+template <int Count>
+inline void forward_radix8_input_part(Vec* f, std::size_t q, const Mint* in, std::size_t first, std::size_t last,
+									 const Factor& i, const Factor& y, const Factor& z) {
+	for (std::size_t j = first; j < last; ++j) {
+		const Vec f0 = load_radix8_input<0, Count>(in, 8 * j, q);
+		const Vec f1 = load_radix8_input<1, Count>(in, 8 * j, q);
+		const Vec f2 = load_radix8_input<2, Count>(in, 8 * j, q);
+		const Vec f3 = load_radix8_input<3, Count>(in, 8 * j, q);
+		forward_radix8_values(f, q, j, f0, f1, f2, f3, i, y, z);
+	}
+}
+
+template <int Count>
+inline void forward_radix8_input_split(Vec* f, std::size_t q, const std::vector<Mint>& in,
+									  const Factor& i, const Factor& y, const Factor& z) {
+	const std::size_t remainder = in.size() % (8 * q), full = remainder / 8, tail = remainder % 8;
+	forward_radix8_input_part<Count + 1>(f, q, in.data(), 0, full, i, y, z);
+	if (tail) {
+		Vec values[4] = {_mm256_setzero_si256(), _mm256_setzero_si256(), _mm256_setzero_si256(), _mm256_setzero_si256()};
+		for (int stream = 0; stream < Count; ++stream) {
+			std::memcpy(values + stream, in.data() + 8 * (full + q * stream), sizeof(Vec));
+		}
+		std::memcpy(values + Count, in.data() + 8 * (full + q * Count), tail * sizeof(Mint));
+		forward_radix8_values(f, q, full, values[0], values[1], values[2], values[3], i, y, z);
+	}
+	forward_radix8_input_part<Count>(f, q, in.data(), full + (tail != 0), q, i, y, z);
+}
+
+inline void forward_radix8_input(Vec* f, std::size_t q, const std::uint32_t* roots, const std::vector<Mint>& in) {
+	static_assert(sizeof(Mint) == sizeof(std::uint32_t) && std::is_trivially_copyable_v<Mint>);
+	const Factor i(roots[1], roots[9]), y(roots[2], roots[10]), z(roots[3], roots[11]);
+	switch (in.size() / (8 * q)) {
+	case 0: return forward_radix8_input_split<0>(f, q, in, i, y, z);
+	case 1: return forward_radix8_input_split<1>(f, q, in, i, y, z);
+	case 2: return forward_radix8_input_split<2>(f, q, in, i, y, z);
+	case 3: return forward_radix8_input_split<3>(f, q, in, i, y, z);
+	default: return forward_radix8_input_part<4>(f, q, in.data(), 0, q, i, y, z);
+	}
+}
