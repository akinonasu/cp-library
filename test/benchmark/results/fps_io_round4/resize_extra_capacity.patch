+inline void prepare_fps_input_output(std::vector<Mint> &out, std::size_t n) {
+	if (n <= out.capacity()) return;
+	constexpr std::size_t extra = 2u * 1024 * 1024 / sizeof(Mint);
+	if (n - out.size() >= (1u << 17) && extra <= out.max_size() && n <= out.max_size() - extra) {
+		try { out.reserve(n + extra); }
+		catch (const std::bad_alloc &) { out.reserve(n); }
+	} else out.reserve(n);
+	if (n - out.size() < (1u << 17)) return;
+	[[maybe_unused]] const auto advise = [](std::uintptr_t first, std::uintptr_t end, std::uintptr_t alignment, int advice) {
+		const auto lo = (first + alignment - 1) & ~(alignment - 1), hi = end & ~(alignment - 1);
+		if (lo < hi) static_cast<void>(madvise(reinterpret_cast<void *>(lo), hi - lo, advice));
+	};
+#if defined(MADV_HUGEPAGE)
+	advise(reinterpret_cast<std::uintptr_t>(out.data()), reinterpret_cast<std::uintptr_t>(out.data() + out.capacity()), 2u * 1024 * 1024, MADV_HUGEPAGE);
+#endif
+#if defined(MADV_POPULATE_WRITE)
+	advise(reinterpret_cast<std::uintptr_t>(out.data() + out.size()), reinterpret_cast<std::uintptr_t>(out.data() + n), 4096, MADV_POPULATE_WRITE);
+#endif
+}
