+struct MontgomeryInputIterator {
+	using iterator_category = std::random_access_iterator_tag;
+	using value_type = Mint;
+	using difference_type = std::ptrdiff_t;
+	using pointer = void;
+	using reference = Mint;
+	const unsigned *p;
+	[[gnu::always_inline]] Mint operator*() const { return Mint::raw(*p); }
+	[[gnu::always_inline]] Mint operator[](difference_type n) const { return Mint::raw(p[n]); }
+	[[gnu::always_inline]] MontgomeryInputIterator &operator++() { ++p; return *this; }
+	[[gnu::always_inline]] MontgomeryInputIterator operator++(int) { auto x = *this; ++*this; return x; }
+	[[gnu::always_inline]] MontgomeryInputIterator &operator--() { --p; return *this; }
+	[[gnu::always_inline]] MontgomeryInputIterator operator--(int) { auto x = *this; --*this; return x; }
+	[[gnu::always_inline]] MontgomeryInputIterator &operator+=(difference_type n) { p += n; return *this; }
+	[[gnu::always_inline]] MontgomeryInputIterator &operator-=(difference_type n) { p -= n; return *this; }
+	friend MontgomeryInputIterator operator+(MontgomeryInputIterator x, difference_type n) { return x += n; }
+	friend MontgomeryInputIterator operator+(difference_type n, MontgomeryInputIterator x) { return x += n; }
+	friend MontgomeryInputIterator operator-(MontgomeryInputIterator x, difference_type n) { return x -= n; }
+	friend difference_type operator-(MontgomeryInputIterator a, MontgomeryInputIterator b) { return a.p - b.p; }
+	auto operator<=>(const MontgomeryInputIterator &) const = default;
+};
